[Unit]
Description=2B Service Telegram news worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=2bservice
Group=2bservice
WorkingDirectory=/opt/2bservice/current
EnvironmentFile=/etc/2bservice/2bservice.env
Environment=NODE_ENV=production
Environment=NEWS_STATE_FILE=/var/lib/2bservice/telegram-news.json
Environment=NEWS_WORKER_LOCK_FILE=/var/lib/2bservice/telegram-news-worker.lock
ExecStart=/usr/bin/node --import tsx /opt/2bservice/current/scripts/telegram-news-worker.ts
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/2bservice

[Install]
WantedBy=multi-user.target
